enable
configure terminal
hostname RT01
no ip domain lookup
banner motd #
VINDKRAFT A/S - RESTRICTED NETWORK ACCESS
Authorized personnel only.
All activities are monitored and logged.
Unauthorized access is prohibited.
#
ip domain name vindkraft.local
service password-encryption
enable secret Password1!
username admin privilege 15 secret Password1!
crypto key generate rsa modulus 2048
ip ssh version 2
line con 0
 logging synchronous
 exit
line vty 0 4
 login local
 transport input ssh
 exec-timeout 10 0
 logging synchronous
 exit
ip access-list extended ACL-SENSOR-GUARD
 remark V05: kun sensor til samlernet tilladt, OSPF altid tilladt
 permit ospf any any
 permit ip 10.20.120.0 0.0.0.255 10.30.130.0 0.0.0.255
 deny ip 10.20.120.0 0.0.0.255 10.10.0.0 0.0.255.255 log
 deny ip 10.20.120.0 0.0.0.255 10.20.0.0 0.0.255.255 log
 deny ip 10.20.120.0 0.0.0.255 10.30.0.0 0.0.255.255 log
 deny ip 10.20.120.0 0.0.0.255 10.255.0.0 0.0.255.255 log
 permit ip any any
 exit
interface Loopback0
 description Router-ID / transport
 ip address 10.255.255.1 255.255.255.255
 exit
interface GigabitEthernet0/0/0
 description WAN-trunk til SW01 Gi1/0/1 (VLAN 912/913)
 no ip address
 no shutdown
 exit
interface GigabitEthernet0/0/0.912
 description WAN RT01-RT02 (OSPF)
 encapsulation dot1Q 912
 ip address 10.255.12.1 255.255.255.252
 ip access-group ACL-SENSOR-GUARD in
 ip ospf network point-to-point
 ip ospf hello-interval 1
 ip ospf dead-interval 3
 exit
interface GigabitEthernet0/0/0.913
 description WAN RT01-RT03 (OSPF)
 encapsulation dot1Q 913
 ip address 10.255.13.1 255.255.255.252
 ip ospf network point-to-point
 ip ospf hello-interval 1
 ip ospf dead-interval 3
 exit
interface GigabitEthernet0/0/1
 description HQ-trunk til SW01 Gi1/0/4 (VLAN 10/110)
 no ip address
 no shutdown
 exit
interface GigabitEthernet0/0/1.10
 description HQ management
 encapsulation dot1Q 10
 ip address 10.10.10.1 255.255.255.0
 exit
interface GigabitEthernet0/0/1.110
 description HQ driftsledelse
 encapsulation dot1Q 110
 ip address 10.10.110.1 255.255.255.0
 exit
router ospf 1
 router-id 10.255.255.1
 log-adjacency-changes
 passive-interface default
 no passive-interface GigabitEthernet0/0/0.912
 no passive-interface GigabitEthernet0/0/0.913
 network 10.255.12.0 0.0.0.3 area 0
 network 10.255.13.0 0.0.0.3 area 0
 network 10.10.10.0 0.0.0.255 area 0
 network 10.10.110.0 0.0.0.255 area 0
 network 10.255.255.1 0.0.0.0 area 0
 exit
end
write memory