enable
conf t
hostname RT01
no ip domain lookup
line con 0
exec-timeout 0 0
logging sync
ipv6 unicast-routing
router ospfv3 1
address-family ipv4 unicast
  router-id 1.1.1.1
 exit-address-family
address-family ipv6 unicast
  router-id 1.1.1.1
 exit-address-family
interface GigabitEthernet0/0/0
 ip address 10.0.0.2 255.255.255.252
 ipv6 address 2001:db8:feed:1::2/64
 ipv6 address fe80::1:1 link-local
 ospfv3 network point-to-point
 ospfv3 1 ipv6 area 0
 ospfv3 1 ipv4 area 0
 no shutdown
 exit
interface GigabitEthernet0/0/1
 ip address 209.165.200.5 255.255.255.252
 ipv6 address 2001:db8:209:4::5/64
 ipv6 address fe80::1:2 link-local
 no shutdown
 exit
router bgp 65000
 bgp log-neighbor-changes
 neighbor 209.165.200.6 remote-as 65001
 neighbor 2001:db8:209:4::6 remote-as 65001
 address-family ipv4 unicast
 neighbor 209.165.200.6 activate
 exit-address-family
 address-family ipv6 unicast
 neighbor 2001:db8:209:4::6 activate
 exit-address-family
 exit
router bgp 65000
 neighbor 10.0.0.1 remote-as 65000
 neighbor 10.0.0.6 remote-as 65000
 address-family ipv4 unicast
 neighbor 10.0.0.1 activate
 neighbor 10.0.0.6 activate
 neighbor 10.0.0.1 next-hop-self
 neighbor 10.0.0.6 next-hop-self
 exit-address-family
 neighbor 2001:db8:feed:1::1 remote-as 65000
 neighbor 2001:db8:feed:2::6 remote-as 65000
 address-family ipv6 unicast
 neighbor 2001:db8:feed:1::1 activate
 neighbor 2001:db8:feed:1::1 next-hop-self
 neighbor 2001:db8:feed:2::6 activate
 neighbor 2001:db8:feed:2::6 next-hop-self
 exit-address-family
 exit
ip as-path access-list 10 permit ^$
router bgp 65000
 address-family ipv4 unicast
 neighbor 209.165.200.6 filter-list 10 out
 exit-address-family
 address-family ipv6 unicast
 neighbor 2001:db8:209:4::6 filter-list 10 out
 exit-address-family
 exit
end