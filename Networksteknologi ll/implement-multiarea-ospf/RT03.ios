enable
conf t
hostname RT03
no ip domain lookup
line con 0
 logging sync
 exec-time 0 0
 exit
interface g0/0/0
 ip add 172.16.1.2 255.255.255.252
 ipv6 add 2001:db8:acad:a002::2/64
 ipv6 add fe80::3:2 link-local
 no shutdown
 exit
interface GigabitEthernet0/0/1
 ip address 10.10.4.1 255.255.255.252
 ipv6 add 2001:db8:acad:2001::1/64
 ipv6 add fe80::3:1 link-local
 no shutdown
ipv6 unicast-routing
router ospfv3 123
 router-id 3.3.3.1
 address-family ipv4 unicast
 exit-address-family
 address-family ipv6 unicast
 exit-address-family
 exit
interface g0/0/0
 ospfv3 123 ipv4 area 0
 ospfv3 123 ipv6 area 0
 exit
interface g0/0/1
 ospfv3 123 ipv4 area 2
 ospfv3 123 ipv6 area 2
 exit
router ospfv3 123 
 address-family ipv6 unicast 
 area 2 range 2001:db8:acad:2000::/52
 exit
interface g0/0/0 
 ospfv3 network point-to-point
 exit 
end