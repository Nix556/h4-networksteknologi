enable
conf t
hostname R2
banner motd # This is R2, Trouble Ticket 20.1.1.2 #
no ip domain lookup
ipv6 unicast-routing
line con 0
 logging synchronous
 exec-timeout 0 0
exit
interface g0/0/0
 ipv6 address 2001:db8:c0c0:a001::2/64
 ipv6 address fe80::a001:2 link-local
 ip address 192.168.2.2 255.255.255.0
 ospfv3 1 ipv4 area 0
 ospfv3 1 ipv6 area 0
 no shutdown
interface g0/0/1
 ipv6 address 2001:db8:c0c0:a002::2/64
 ipv6 address fe80::a002:2 link-local
 ip address 192.168.5.2 255.255.255.0
 ospfv3 1 ipv4 area 0
 ospfv3 1 ipv6 area 0
 no shutdown
interface lo1
 ipv6 address 2001:db8:c0c0:a021::1/64
 ipv6 address fe80::a021:1 link-local
 ip address 192.168.3.1 255.255.255.0
 ospfv3 1 ipv4 area 0
 ospfv3 1 ipv6 area 0
 ospfv3 1 ipv4 network point-to-point
 ospfv3 1 ipv6 network point-to-point
exit
interface lo2
 ipv6 address 2001:db8:c0c0:a022::1/64
 ipv6 address fe80::a022:1 link-local
 ip address 192.168.4.1 255.255.255.0
 ospfv3 1 ipv4 area 0
 ospfv3 1 ipv6 area 0
 ospfv3 1 ipv4 network point-to-point
 ospfv3 1 ipv6 network point-to-point
exit
interface lo0
 description Loopback for BGP peering
 ip address 192.168.99.2 255.255.255.255
 ipv6 address 2001:db8:c0c0:99::2/128
 ipv6 address fe80::99:2 link-local
 ospfv3 1 ipv4 area 0
 ospfv3 1 ipv6 area 0
exit
router ospfv3 1
 address-family ipv4 unicast
  router-id 2.2.2.2
 exit
 address-family ipv6 unicast
  router-id 2.2.2.2
 exit
exit
router bgp 65000
 bgp router-id 2.2.2.2
 neighbor 192.168.99.1 remote-as 65000
 neighbor 192.168.99.1 update-source loopback0
 neighbor 2001:db8:c0c0:99::1 remote-as 65000
 neighbor 2001:db8:c0c0:99::1 update-source loopback0
 neighbor 192.168.99.3 remote-as 65000
 neighbor 192.168.99.3 update-source loopback0
 neighbor 2001:db8:c0c0:99::3 remote-as 65000
 neighbor 2001:db8:c0c0:99::3 update-source loopback0
 address-family ipv4 unicast
  network 192.168.3.0 mask 255.255.255.0
  network 192.168.4.0 mask 255.255.255.0
  neighbor 192.168.99.1 activate
  neighbor 192.168.99.3 activate
 exit
 address-family ipv6 unicast
  network 2001:db8:c0c0:a021::/64
  network 2001:db8:c0c0:a022::/64
  neighbor 2001:db8:c0c0:99::1 activate
  neighbor 2001:db8:c0c0:99::3 activate
exit
! BGP processen nulstilles, så de nye local-preference-værdier bliver anvendt på alle routere i AS 65000
clear bgp all 65000