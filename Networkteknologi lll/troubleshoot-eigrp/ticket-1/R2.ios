enable
conf t
hostname R2
banner motd # This is R2, Trouble Ticket 4.1.1.1 #
enable secret cisco12345
username admin privilege 15 algorithm-type scrypt secret cisco12345
interface g0/0/0
 ip address 10.0.12.2 255.255.255.0
 no shutdown
 exit
interface g0/0/1
 ip address 10.0.23.1 255.255.255.0
 no shutdown
 exit
router eigrp 412
! R2 havde samme router-id som R1, hver router skal have et unikt id konfigureret
 eigrp router-id 2.2.2.2
 network 10.0.12.0 0.0.0.255
 network 10.0.23.0 0.0.0.255
 exit
line con 0
 exec-timeout 0 0
 logging synchronous
 exit
line vty 0 4
 login local
 transport input telnet
 exit