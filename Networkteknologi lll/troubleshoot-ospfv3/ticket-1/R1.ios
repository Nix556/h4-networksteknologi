enable
conf t
hostname R1
banner motd # This is R1, Trouble Ticket 9.1.1.1 #
no ip domain lookup
ipv6 unicast-routing
line con 0
 logging synchronous
 exec-timeout 0 0
exit
interface g0/0/0
 ipv6 address 2001:db8:acad:a201::1/64
 ipv6 address fe80::a201:1 link-local
 ospfv3 1 ipv6 area 2
 no shutdown
interface g0/0/1
 ipv6 address 2001:db8:acad:a001::1/64
 ipv6 address fe80::a001:1 link-local
 ospfv3 1 ipv6 area 0
 no shutdown
interface lo0
 ipv6 address 2001:db8:feed:1::1/64
 ipv6 address fe80::1:1 link-local
exit
router ospfv3 1
 address-family ipv6 unicast
  router-id 1.1.1.1