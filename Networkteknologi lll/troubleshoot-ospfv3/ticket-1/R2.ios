enable
conf t
hostname R2
banner motd # This is R2, Trouble Ticket 9.1.1.1 #
no ip domain lookup
ipv6 unicast-routing
line con 0
 logging synchronous
 exec-timeout 0 0
exit
interface g0/0/0
 ipv6 address 2001:db8:acad:a201::2/64
 ipv6 address fe80::a201:2 link-local
 ! ændret ipv6 ospf til ospfv3
 ospfv3 1 ipv6 area 2
 no shutdown
 exit
interface lo0
 ipv6 address 2001:db8:acad:a202::1/64
 ipv6 address fe80::a202:1 link-local
 ! ændret ipv6 ospf til ospfv3
 ospfv3 1 ipv6 area 2
 ipv6 ospf network point-to-point
 no shutdown
 exit
! der er blevet brugt den forkerte kommado "ipv6 router ospf 1", men den korrekte måde at skrive det på er "router ospfv3 1"
router ospfv3 1
 router-id 2.2.2.2
 area 2 stub
exit