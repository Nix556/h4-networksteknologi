enable
conf t
hostname R3
banner motd # This is R3, Trouble Ticket 9.1.1.3 #
no ip domain lookup
ipv6 unicast-routing
line con 0
 logging synchronous
 exec-timeout 0 0
exit
interface g0/0/1
 ipv6 address 2001:db8:acad:a003::1/64
 ipv6 address fe80::a003:1 link-local
 ospfv3 1 ipv6 area 0
 no shutdown
interface lo0
 ipv6 address 2001:db8:acad:a301::1/64
 ipv6 address fe80::a301:1 link-local
 ospfv3 1 ipv6 area 3
 ipv6 ospf network point-to-point
 no shutdown
exit
router ospfv3 1
 address-family ipv6 unicast
  router-id 3.3.3.3
exit
exit