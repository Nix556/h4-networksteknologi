enable
configure terminal
hostname RT02
no ip domain lookup
interface GigabitEthernet0/0/0
 description WAN-trunk til SW1
 no ip address
 no shutdown
 exit
interface GigabitEthernet0/0/0.912
 description WAN til RT01
 encapsulation dot1Q 912
 ip address 10.255.12.2 255.255.255.252
 no shutdown
 exit
interface GigabitEthernet0/0/0.923
 description Primær WAN til RT03
 encapsulation dot1Q 923
 ip address 10.255.23.1 255.255.255.252
 no shutdown
 exit
interface GigabitEthernet0/0/1
 description Trunk til SW2 - filial
 no ip address
 no shutdown
 exit
interface GigabitEthernet0/0/1.20
 description Filial management
 encapsulation dot1Q 20
 ip address 10.20.20.1 255.255.255.0
 no shutdown
 exit
interface GigabitEthernet0/0/1.120
 description Sensor VLAN
 encapsulation dot1Q 120
 ip address 10.20.120.1 255.255.255.0
 no shutdown
 exit
router ospf 10
 router-id 2.2.2.2
 passive-interface default
 no passive-interface GigabitEthernet0/0/0.912
 no passive-interface GigabitEthernet0/0/0.923
 network 10.255.12.0 0.0.0.3 area 0
 network 10.255.23.0 0.0.0.3 area 0
 exit
router bgp 65002
 bgp log-neighbor-changes
 neighbor 10.255.12.1 remote-as 65001
 neighbor 10.255.23.2 remote-as 65003
 network 10.20.120.0 mask 255.255.255.0
 exit