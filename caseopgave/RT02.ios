enable
configure terminal
hostname RT02
no ip domain lookup
ip domain name vindkraft.local
service password-encryption
enable secret Password1!
username admin privilege 15 secret Password1!
crypto key generate rsa modulus 2048
ip ssh version 2
line con 0
 logging synchronous
 exit
line vty 0 4
 login local
 transport input ssh
 exec-timeout 10 0
 logging synchronous
 exit
ip prefix-list PL-SENSOR seq 5 permit 10.20.120.0/24
ip prefix-list PL-DC-COLLECTOR seq 5 permit 10.30.130.0/24
ip prefix-list PL-UNWANTED-TEST seq 5 permit 10.30.250.0/24
ip prefix-list PL-BGP-OUT seq 5 permit 10.20.120.0/24
ip prefix-list PL-BGP-OUT seq 10 permit 10.255.255.2/32
ip prefix-list PL-BGP-IN seq 5 permit 10.30.130.0/24
ip prefix-list PL-BGP-IN seq 10 permit 10.255.255.3/32
! seq 15 er BEVIDST (V01-demo: testprefix i BGP men ikke i OSPF)
ip prefix-list PL-BGP-IN seq 15 permit 10.30.250.0/24
route-map RM-CONN-TO-OSPF permit 10
 match ip address prefix-list PL-SENSOR
 set metric 10
 set metric-type type-2
 set tag 10
 exit
route-map RM-BGP-TO-OSPF deny 5
 match ip address prefix-list PL-UNWANTED-TEST
 exit
route-map RM-BGP-TO-OSPF permit 10
 match ip address prefix-list PL-DC-COLLECTOR
 set metric 50
 set metric-type type-2
 set tag 65
 exit
ip access-list extended ACL-SENSOR-IN
 remark V05: sensor-VLAN 120 - kun samlernet, ingen kontrolnet
 permit icmp 10.20.120.0 0.0.0.255 host 10.20.120.1
 permit ip 10.20.120.0 0.0.0.255 10.30.130.0 0.0.0.255
 deny ip 10.20.120.0 0.0.0.255 10.10.0.0 0.0.255.255 log
 deny ip 10.20.120.0 0.0.0.255 10.20.0.0 0.0.255.255 log
 deny ip 10.20.120.0 0.0.0.255 10.30.0.0 0.0.255.255 log
 deny ip 10.20.120.0 0.0.0.255 10.255.0.0 0.0.255.255 log
 deny ip any any log
 exit
crypto ikev2 proposal IKEV2-PROP
 encryption aes-cbc-256
 integrity sha256
 group 14
 exit
crypto ikev2 policy IKEV2-POL
 proposal IKEV2-PROP
 exit
crypto ikev2 keyring KR-TELEMETRI
 peer RT03
  address 10.255.255.3
  pre-shared-key IPsecKey1!
  exit
 exit
crypto ikev2 profile IKEV2-PROF
 match identity remote address 10.255.255.3 255.255.255.255
 identity local address 10.255.255.2
 authentication remote pre-share
 authentication local pre-share
 keyring local KR-TELEMETRI
 exit
crypto ipsec transform-set TS-AES256 esp-aes 256 esp-sha256-hmac
 mode tunnel
 exit
crypto ipsec profile IPSEC-PROF
 set transform-set TS-AES256
 set ikev2-profile IKEV2-PROF
 exit
ip access-list extended ACL-PBR-SENSOR
 permit ip 10.20.120.0 0.0.0.255 10.30.130.0 0.0.0.255
 exit
! PBR: telemetri ind i tunnelen. Null0 = ingen klartekst-fallback
route-map RM-PBR-SENSOR permit 10
 match ip address ACL-PBR-SENSOR
 set ip next-hop 10.255.100.2
 set interface Null0
 exit
ip local policy route-map RM-PBR-SENSOR
interface Loopback0
 description Router-ID / transport / IPsec-endpoint
 ip address 10.255.255.2 255.255.255.255
 exit
interface Tunnel0
 description IPsec VTI RT02-RT03 (telemetri)
 ip address 10.255.100.1 255.255.255.248
 ip mtu 1400
 ip tcp adjust-mss 1360
 tunnel source Loopback0
 tunnel destination 10.255.255.3
 tunnel mode ipsec ipv4
 tunnel protection ipsec profile IPSEC-PROF
 no shutdown
 exit
interface GigabitEthernet0/0/0
 description WAN-trunk til SW01 Gi1/0/2 (VLAN 912/923)
 no ip address
 no shutdown
 exit
interface GigabitEthernet0/0/0.912
 description WAN RT02-RT01 (OSPF)
 encapsulation dot1Q 912
 ip address 10.255.12.2 255.255.255.252
 ip ospf network point-to-point
 ip ospf hello-interval 1
 ip ospf dead-interval 3
 exit
interface GigabitEthernet0/0/0.923
 description WAN RT02-RT03 (eBGP)
 encapsulation dot1Q 923
 ip address 10.255.23.1 255.255.255.252
 bfd interval 100 min_rx 100 multiplier 3
 exit
interface GigabitEthernet0/0/1
 description Filial-trunk til SW02 Gi1/0/1 (VLAN 20/120)
 no ip address
 no shutdown
 exit
interface GigabitEthernet0/0/1.20
 description Filial management
 encapsulation dot1Q 20
 ip address 10.20.20.1 255.255.255.0
 exit
interface GigabitEthernet0/0/1.120
 description Sensor-VLAN 120
 encapsulation dot1Q 120
 ip address 10.20.120.1 255.255.255.0
 ip access-group ACL-SENSOR-IN in
 ip policy route-map RM-PBR-SENSOR
 exit
router ospf 1
 router-id 10.255.255.2
 log-adjacency-changes
 passive-interface default
 no passive-interface GigabitEthernet0/0/0.912
 network 10.255.12.0 0.0.0.3 area 0
 network 10.20.20.0 0.0.0.255 area 0
 network 10.255.255.2 0.0.0.0 area 0
 redistribute connected subnets route-map RM-CONN-TO-OSPF
 redistribute bgp 65002 subnets route-map RM-BGP-TO-OSPF
 exit
router bgp 65002
 bgp router-id 10.255.255.2
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 neighbor 10.255.23.2 remote-as 65003
 neighbor 10.255.23.2 description eBGP-RT03-DC
 neighbor 10.255.23.2 timers 3 9
 neighbor 10.255.23.2 fall-over bfd
 address-family ipv4
  network 10.20.120.0 mask 255.255.255.0
  network 10.255.255.2 mask 255.255.255.255
  neighbor 10.255.23.2 activate
  neighbor 10.255.23.2 prefix-list PL-BGP-OUT out
  neighbor 10.255.23.2 prefix-list PL-BGP-IN in
  exit-address-family
 exit
end
write memory