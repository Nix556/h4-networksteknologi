enable
configure terminal
hostname RT03
no ip domain lookup
interface GigabitEthernet0/0/0
 description WAN-interface til SW1
 no shutdown
 exit
interface GigabitEthernet0/0/0.913
 description WAN til RT01 - VLAN 913
 encapsulation dot1Q 913
 ip address 10.255.13.2 255.255.255.252
 exit
interface GigabitEthernet0/0/0.923
 description WAN til RT02 - VLAN 923
 encapsulation dot1Q 923
 ip address 10.255.23.2 255.255.255.252
 exit
interface GigabitEthernet0/0/1
 description DC managementnet
 ip address 10.30.30.1 255.255.255.0
 no shutdown
 exit