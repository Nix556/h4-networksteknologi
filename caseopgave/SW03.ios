enable
configure terminal
hostname SW03
no ip domain-lookup
no ip routing
ip domain-name vindkraft.local
service password-encryption
enable secret Password1!
username admin privilege 15 secret Password1!
crypto key generate rsa modulus 2048
ip ssh version 2
line con 0
 logging synchronous
 exit
line vty 0 4
 login local
 transport input ssh
 exec-timeout 10 0
 logging synchronous
 exit
spanning-tree mode rapid-pvst
line con 0
 logging synchronous
 exit
vlan 30
 name DC-MGMT
 exit
vlan 130
 name DC-SAMLER
 exit
interface GigabitEthernet1/0/1
 description RT03 Gi0/0/1 - DC-trunk 30/130
 switchport mode trunk
 switchport nonegotiate
 switchport trunk allowed vlan 30,130
 exit
interface GigabitEthernet1/0/2
 description DC-samler 10.30.130.10 gw 10.30.130.1
 switchport mode access
 switchport access vlan 130
 spanning-tree portfast
 exit
interface range GigabitEthernet1/0/3-24
 description UBRUGT
 shutdown
 exit
interface range GigabitEthernet1/1/1-4
 description UBRUGT
 shutdown
 exit
interface Vlan1
 no ip address
 shutdown
 exit
interface Vlan30
 description Management SW03
 ip address 10.30.30.2 255.255.255.0
 no shutdown
 exit
ip default-gateway 10.30.30.1
end