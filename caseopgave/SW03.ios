enable
configure terminal
hostname SW03
no ip domain lookup
vlan 30
 name DC-MANAGEMENT
 exit
vlan 130
 name DC-DATAOPSAMLING
 exit
interface GigabitEthernet1/0/1
 description Trunk til RT03 - datacenter
 switchport mode trunk
 switchport trunk allowed vlan 30,130
 no shutdown
 exit
interface Vlan30
 description SW03 management
 ip address 10.30.30.2 255.255.255.0
 no shutdown
 exit
ip default-gateway 10.30.30.1