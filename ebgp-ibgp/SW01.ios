enable
conf t
hostname SW01
no ip domain lookup
line con 0
exec-timeout 0 0
logging sync
ip routing
ipv6 unicast-routing
interface GigabitEthernet1/0/11
 no switchport
 ip address 209.165.200.6 255.255.255.252
 ipv6 address 2001:db8:209:4::6/64
 ipv6 address fe80::d1:1 link-local
 no shutdown
 exit
interface loopback0
 ip address 192.168.1.1 255.255.255.0
 ipv6 enable
 no shutdown
 exit
interface loopback1
 ip address 192.168.2.1 255.255.255.0
 ipv6 enable
 no shutdown
 exit
interface loopback2
 ipv6 address 2001:db8:cab::1/48
 no shutdown
 exit
router bgp 65001
 bgp log-neighbor-changes
 neighbor 209.165.200.5 remote-as 65000
 neighbor 2001:db8:209:4::5 remote-as 65000
 network 192.168.1.0 mask 255.255.255.0
 network 192.168.2.0 mask 255.255.255.0
 address-family ipv6 unicast
 neighbor 2001:db8:209:4::5 activate 
 network 2001:db8:cab::/48 
 exit-address-family 
 exit
end