enable
conf t
hostname RT01
no ip domain lookup
line con 0
 logging sync
 exec-time 0 0
 exit
interface g0/0/0
 ip add 172.16.0.2 255.255.255.252
 ipv6 add 2001:db8:acad:a001::2/64
 ipv6 add fe80::1:2 link-local
 no shutdown
 exit
interface GigabitEthernet0/0/1
 ipv6 add 2001:db8:acad:1001::1/64
 ipv6 add fe80::1:1 link-local
 no shutdown
 exit
ipv6 unicast-routing
router ospfv3 123
 address-family ipv4 unicast
 router-id 1.1.1.1
 exit-address-family
 address-family ipv6 unicast
 router-id 1.1.1.1
 exit-address-family
 exit
interface g0/0/0
 ospfv3 123 ipv4 area 0
 ospfv3 123 ipv6 area 0
 exit
interface g0/0/1
 ospfv3 123 ipv4 area 1
 ospfv3 123 ipv6 area 1
 exit
end