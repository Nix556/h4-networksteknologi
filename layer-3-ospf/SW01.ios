enable
conf t
hostname SW01
no ip domain lookup
line con 0
 exec-timeout 0 0
 logging synchronous
 exit
interface g1/0/11
 no switchport
 ipv6 add 2001:db8:acad:1001::2/64
 ipv6 add fe80::d1:2 link-local
 no shutdown
 exit
interface g1/0/23
 no switchport
 ipv6 add 2001:db8:acad:1002::1/64
 ipv6 add fe80::d1:1 link-local
 no shutdown
 exit
ipv6 unicast-routing
ipv6 router ospf 123
 router-id 1.1.1.2
 exit
interface g1/0/11
 ipv6 ospf 123 area 1
 exit
interface g1/0/23
 ipv6 ospf 123 area 1
 exit
ipv6 router ospf 123 
 passive-interface g1/0/23
 exit
end