enable
conf t
hostname SW02
no ip domain lookup
line con 0
 logging sync
 exec-time 0 0
 exit
interface gi1/0/11
 no switchport
 ip address 10.10.4.2 255.255.255.252
 ipv6 add 2001:db8:acad:2001::2/64
 ipv6 add fe80::d2:2 link-local
 no shutdown
 exit
interface gi1/0/23
 no switchport
 ip address 10.10.5.1 255.255.255.0
 ipv6 add 2001:db8:acad:2002::1/64
 ipv6 add fe80::d2:1 link-local
 no shutdown
 exit
ip routing
ipv6 unicast-routing
router ospfv3 123
 address-family ipv4 unicast
 router-id 3.3.3.2
 exit-address-family
 address-family ipv6 unicast
 router-id 3.3.3.2
 exit-address-family
 exit
interface g1/0/11
 ospfv3 123 ipv4 area 2
 ospfv3 123 ipv6 area 2
 exit
interface g 1/0/23
 ospfv3 123 ipv4 area 2
 ospfv3 123 ipv6 area 2
 exit
end